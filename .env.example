# Cohere API Key (get yours at https://dashboard.cohere.com/api-keys)
# If not set, the system runs in simulation mode (no AI calls)
COHERE_API_KEY=your-cohere-api-key-here

# MCP Server Config
MCP_DEMO_PORT=3100

# Vault Path (override default)
# VAULT_ROOT=./vault

# Watcher
WATCHER_POLL_INTERVAL=3

# Logging
LOG_LEVEL=INFO
